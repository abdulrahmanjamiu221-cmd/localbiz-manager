FLASK_APP=run.py
FLASK_ENV=development
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret

# For local development, leave DATABASE_URL blank to use instance/localbiz.sqlite.
# For Supabase, use the PostgreSQL connection string from Project Settings > Database.
# It is not the SUPABASE_URL (REST API URL). Prefer the transaction pooler for hosted apps.
DATABASE_URL=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
COOKIE_SECURE=false
RATELIMIT_STORAGE_URI=memory://
